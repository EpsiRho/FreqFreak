<Window x:Class="FreqFreak.GradientEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FreqFreak"
        xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
        mc:Ignorable="d"
        Foreground="{DynamicResource MainText}"
        AllowsTransparency="True"
        ResizeMode="NoResize"      
        WindowStyle="None"
        Background="Transparent"
        Title="Gradient Editor" Height="450" Width="450" MinWidth="450">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ColorPicker;component/Styles/DefaultColorPickerStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Window.Resources>
    <Grid SizeChanged="Grid_SizeChanged"
          MouseDown="Grid_MouseDown">
        <!-- Window Title -->
        <Grid Height="30"  
              x:Name="TitleBar"
              Background="#353535"
              VerticalAlignment="Top"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
              MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
            <Image Source="/FreqFreak;component/Images/icon2.png"
                   HorizontalAlignment="Left"
                   Margin="5,1,0,2"/>
            <TextBlock Text="Gradient Editor"
                       x:Name="TitleBarText"
                       FontSize="16"
                       Margin="35,4,0,0"/>

            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="40" 
                        x:Name="MinimizeButton"
                        Click="Minimize_Click"
                        Style="{StaticResource TitleButtonStyle}">
                    <Path Data="F1 M 20 7.5 L 20 10.498047 L 0 10.498047 L 0 7.5 Z " Fill="#7e7e7e" Stretch="Uniform" 
                          Height="15" Width="15" Margin="0,4,0,0"/>
                </Button>
                <Button Width="40"
                        x:Name="ExitButton"
                        Click="ExitButton_Click"
                        Style="{StaticResource TitleButtonStyle}">
                    <Path Data="F1 M 19.814453 2.314453 L 12.119141 10 L 19.814453 17.685547 L 17.685547 19.814453 L 10 12.119141 L 2.314453 19.814453 L 0.185547 17.685547 L 7.880859 10 L 0.185547 2.314453 L 2.314453 0.185547 L 10 7.880859 L 17.685547 0.185547 Z " 
                          Fill="#7e7e7e" Stretch="Uniform" Height="10" Width="10" Margin="0,2,0,0"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Window Border -->
        <Border BorderThickness="3"
                x:Name="WindowBorder"
                Margin="0,30,0,0"
                Panel.ZIndex="5"
                BorderBrush="#7e7e7e"/>
        <Border BorderThickness="3"
                Margin="0,30,0,0"
                IsHitTestVisible="True"
                Panel.ZIndex="0"
                Background="{StaticResource HitRegBg}"/>

        <Grid Background="{StaticResource MainBg}"
              VerticalAlignment="Top"
              Margin="0,30,0,0"
              Height="20"/>

        <Grid Background="{StaticResource MainBg}"
              Margin="0,80,0,0"/>

        <Grid Margin="0,30,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="10*"/>
            </Grid.RowDefinitions>

            <Rectangle Grid.Column="0" Grid.Row="0" 
                       Grid.ColumnSpan="2"
                       Margin="10,10,10,10"
                       x:Name="GradientDisplay"
                       Fill="Transparent"
                       StrokeThickness="3"
                       Stroke="#7e7e7e"
                       Height="25"
                       RadiusX="5"
                       RadiusY="5"
                       HorizontalAlignment="Stretch" 
                       VerticalAlignment="Stretch"/>

            <Grid Background="{DynamicResource ResourceKey=MainBg}"
                  VerticalAlignment="Top"
                  Grid.ColumnSpan="2"
                  Margin="0,20,0,0"
                  x:Name="HeaderCutoutGrid"
                  Height="30">

                <Grid.Clip>
                    <CombinedGeometry GeometryCombineMode="Exclude">
                        <!-- Full Rectangle -->
                        <CombinedGeometry.Geometry1>
                            <RectangleGeometry Rect="0,0,400,200"/>
                        </CombinedGeometry.Geometry1>

                        <!-- Inner rounded rectangle to exclude -->
                        <CombinedGeometry.Geometry2>
                            <RectangleGeometry Rect="10,2,100,25" RadiusX="5" RadiusY="5"/>
                        </CombinedGeometry.Geometry2>
                    </CombinedGeometry>
                </Grid.Clip>

            </Grid>

            <GroupBox Header="Gradient Colors"
                      Margin="12,2,5,2"
                      Grid.Column="0"
                      Grid.Row="1">
                <ListView x:Name="ColorsList" BorderThickness="0"
                          Focusable="False"
                          Style="{StaticResource WinUI3ListViewStyle}"
                          ItemContainerStyle="{StaticResource ColorSelectorItemTemplate}"
                          Margin="10,0,10,0"/>
            </GroupBox>

            <GroupBox Header="Controls"
                      Margin="0,2,12,2"
                      Grid.Column="1"
                      Grid.Row="1">
                <StackPanel Margin="10,0,10,0">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Button x:Name="AddColorButton"
                                ToolTip="Add this color to the gradient"
                                Grid.Column="0"
                                Grid.Row="0"
                                Style="{StaticResource WinUI3ButtonStyle}"
                                Click="AddColorButton_Click"
                                Margin="0,0,10,0">
                            <Path Data="F1 M 20 9.375 L 20 10.625 L 10.625 10.625 L 10.625 20 L 9.375 20 L 9.375 10.625 L 0 10.625 L 0 9.375 L 9.375 9.375 L 9.375 0 L 10.625 0 L 10.625 9.375 Z " 
                                  Fill="White" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="MoveUpButton"
                                Grid.Column="0"
                                Grid.Row="1"
                                ToolTip="Move the selected color up"
                                Style="{StaticResource WinUI3ButtonStyle}"
                                Click="MoveUpButton_Click"
                                Margin="0,10,10,0">
                            <Path Data="F1 M 18.310547 10.126953 L 10.625 2.441406 L 10.625 20 L 9.375 20 L 9.375 2.441406 L 1.689453 10.126953 L 0.810547 9.248047 L 10 0.058594 L 19.189453 9.248047 Z " 
                                  Fill="White" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="MoveDownButton"
                                ToolTip="Move the selected color down"
                                Grid.Column="1"
                                Grid.Row="1"
                                Click="MoveDownButton_Click"
                                Style="{StaticResource WinUI3ButtonStyle}"
                                Margin="0,10,10,0">
                            <Path Data="F1 M 19.189453 10.751953 L 10 19.941406 L 0.810547 10.751953 L 1.689453 9.873047 L 9.375 17.558594 L 9.375 0 L 10.625 0 L 10.625 17.558594 L 18.310547 9.873047 Z " 
                                  Fill="White" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="EditButton"
                                ToolTip="Copy the selected color into the color picker"
                                Grid.Column="1"
                                Grid.Row="0"
                                Style="{StaticResource WinUI3ButtonStyle}"
                                Click="EditButton_Click"
                                Margin="0,0,10,0">
                            <Path Data="F1 M 20 15 L 17.5 15 L 17.5 18.75 C 17.5 18.925781 17.467447 19.088541 17.402344 19.238281 C 17.337238 19.388021 17.247721 19.519857 17.133789 19.633789 C 17.019855 19.747721 16.88802 19.83724 16.738281 19.902344 C 16.588541 19.967447 16.425781 20 16.25 20 L 1.25 20 L 1.25 1.25 L 7.5 1.25 L 7.5 0 L 14.638672 0 L 20 5.361328 Z M 17.5 5 L 17.861328 5 L 17.5 4.638672 Z M 8.75 11.25 L 10 11.25 L 10 2.5 L 15.361328 2.5 L 14.111328 1.25 L 8.75 1.25 Z M 2.5 18.75 L 13.75 18.75 L 13.75 15 L 10 15 L 10 12.5 L 7.5 12.5 L 7.5 2.5 L 2.5 2.5 Z M 16.25 15 L 15 15 L 15 18.75 L 16.25 18.75 Z M 18.75 13.75 L 18.75 6.25 L 16.25 6.25 L 16.25 3.75 L 11.25 3.75 L 11.25 13.75 Z " 
                                  Fill="White" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="ReverseButton"
                                ToolTip="Reverse the gradient Direction"
                                Grid.Column="2"
                                Grid.Row="1"
                                Style="{StaticResource WinUI3ButtonStyle}"
                                Click="ReverseButton_Click"
                                Margin="0,10,10,0">
                            <Path Data="F1 M 20 13.75 L 20 15 L 2.441406 15 L 4.033203 16.591797 L 3.154297 17.470703 L 0.058594 14.375 L 3.154297 11.279297 L 4.033203 12.158203 L 2.441406 13.75 Z M 15.966797 7.841797 L 17.558594 6.25 L 0 6.25 L 0 5 L 17.558594 5 L 15.966797 3.408203 L 16.845703 2.529297 L 19.941406 5.625 L 16.845703 8.720703 Z " 
                                  Fill="White" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="DeleteButton"
                                ToolTip="Remove the selected Color"
                                Grid.Column="2"
                                Grid.Row="0"
                                Style="{StaticResource WinUI3ButtonStyle}"
                                Click="DeleteButton_Click"
                                Margin="0,0,10,0">
                            <Path Data="F1 M 17.5 3.75 L 16.25 3.75 L 16.25 18.125 C 16.25 18.385416 16.201172 18.629557 16.103516 18.857422 C 16.005859 19.085287 15.872396 19.283854 15.703125 19.453125 C 15.533854 19.622396 15.335286 19.755859 15.107422 19.853516 C 14.879557 19.951172 14.635416 20 14.375 20 L 4.375 20 C 4.114583 20 3.870442 19.951172 3.642578 19.853516 C 3.414713 19.755859 3.216146 19.622396 3.046875 19.453125 C 2.877604 19.283854 2.744141 19.085287 2.646484 18.857422 C 2.548828 18.629557 2.5 18.385416 2.5 18.125 L 2.5 3.75 L 1.25 3.75 L 1.25 2.5 L 6.25 2.5 L 6.25 1.25 C 6.25 1.074219 6.282552 0.911459 6.347656 0.761719 C 6.41276 0.61198 6.502278 0.480145 6.616211 0.366211 C 6.730143 0.252279 6.861979 0.162762 7.011719 0.097656 C 7.161458 0.032553 7.324218 0 7.5 0 L 11.25 0 C 11.425781 0 11.588541 0.032553 11.738281 0.097656 C 11.888021 0.162762 12.019856 0.252279 12.133789 0.366211 C 12.247721 0.480145 12.337238 0.61198 12.402344 0.761719 C 12.467447 0.911459 12.5 1.074219 12.5 1.25 L 12.5 2.5 L 17.5 2.5 Z M 7.5 2.5 L 11.25 2.5 L 11.25 1.25 L 7.5 1.25 Z M 15 3.75 L 3.75 3.75 L 3.75 18.125 C 3.75 18.294271 3.811849 18.440756 3.935547 18.564453 C 4.059245 18.68815 4.205729 18.75 4.375 18.75 L 14.375 18.75 C 14.544271 18.75 14.690755 18.68815 14.814453 18.564453 C 14.93815 18.440756 14.999999 18.294271 15 18.125 Z M 7.5 16.25 L 6.25 16.25 L 6.25 6.25 L 7.5 6.25 Z M 10 16.25 L 8.75 16.25 L 8.75 6.25 L 10 6.25 Z M 12.5 16.25 L 11.25 16.25 L 11.25 6.25 L 12.5 6.25 Z " 
                                  Fill="White" Stretch="Uniform" />
                        </Button>

                        <TextBox Grid.ColumnSpan="3"
                                 Grid.Row="2"
                                 Style="{StaticResource WinUI3TextBoxStyle}"
                                 x:Name="ColorsTextInput"
                                 MouseEnter="ColorsTextInput_MouseEnter"
                                 MouseLeave="ColorsTextInput_MouseLeave"
                                 TextChanged="ColorsTextInput_TextChanged"
                                 AcceptsReturn="True"
                                 Foreground="Transparent"
                                 Height="30"
                                 TextWrapping="Wrap"
                                 Margin="0,10,0,0">
                            <TextBox.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Height"
                                                             To="110" Duration="0:0:0.1"/>
                                            <ColorAnimation Storyboard.TargetProperty="(TextBox.Foreground).(SolidColorBrush.Color)"
                                                             To="White" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Height"
                                                             To="30" Duration="0:0:0.1"/>
                                            <ColorAnimation Storyboard.TargetProperty="(TextBox.Foreground).(SolidColorBrush.Color)"
                                                            To="Transparent" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBox.Triggers>
                        </TextBox>
                    </Grid>

                    <TextBlock Grid.Column="1" Grid.Row="3" Margin="0,10,0,0">Load Preset</TextBlock>
                    <ComboBox x:Name="PresetSelector" SelectionChanged="PresetSelector_SelectionChanged"
                              Width="180"
                              Height="30"
                              Style="{StaticResource WinUI3ComboBoxStyle}">
                        <ComboBoxItem>Rainbow</ComboBoxItem>
                        <ComboBoxItem>Sakura</ComboBoxItem>
                        <ComboBoxItem>Flames</ComboBoxItem>
                        <ComboBoxItem>Retro</ComboBoxItem>
                        <ComboBoxItem>OceanDepths</ComboBoxItem>
                        <ComboBoxItem>MidnightSurf</ComboBoxItem>
                        <ComboBoxItem>Pastel</ComboBoxItem>
                        <ComboBoxItem>Watermelon</ComboBoxItem>
                        <ComboBoxItem>SynthwaveSunset</ComboBoxItem>
                        <ComboBoxItem>GrassHills</ComboBoxItem>
                        <ComboBoxItem>Blorange</ComboBoxItem>
                        <ComboBoxItem>Coffee</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </GroupBox>
        </Grid>
        <Popup x:Name="HelpPopup"
               Placement="Top"
               PlacementTarget="{Binding ElementName=HelpButton}"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Style="{StaticResource WinUI3PopupContainerStyle}">
                <Grid>
                    <StackPanel Margin="0,0,0,0">
                        <TextBlock Text="Double click on any color in the Gradient List to show it's editor." Foreground="White" FontSize="14"/>
                        <TextBlock Text="Controls on the side: Add/Copy/Delete" Foreground="White" FontSize="14"/>
                        <TextBlock Text="                                  Move Up/Down/Reverse" Foreground="White" FontSize="14"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <Button HorizontalAlignment="Right"
                Style="{StaticResource TitleButtonStyle}"
                Height="30"
                x:Name="HelpButton"
                Click="HelpButton_Click"
                VerticalAlignment="Bottom" Margin="0,0,20,20">
            <TextBlock FontSize="18" Margin="0,-3,0,0">
                ⓘ
            </TextBlock>
        </Button>
    </Grid>
</Window>
