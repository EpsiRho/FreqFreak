<Window x:Class="FreqFreak.FVZWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FreqFreak"
        mc:Ignorable="d"
        AllowsTransparency="True"
        ResizeMode="NoResize"      
        WindowStyle="None"
        Foreground="{DynamicResource MainText}"
        Background="Transparent"
        Title="FVZ Tool" Height="480" Width="800">
    <Grid Background="{DynamicResource MainBg}">
        <!-- Window Title -->
        <Grid Height="30"  
              x:Name="TitleBar"
              Background="#353535"
              VerticalAlignment="Top"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
              MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
            <Image Source="/FreqFreak;component/Images/icon2.png"
                   HorizontalAlignment="Left"
                   Margin="5,1,0,2"/>
            <TextBlock Text="FVZ Tool"
                       FontSize="16"
                       Margin="35,4,0,0"/>

            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="40" 
                        x:Name="MinimizeButton"
                        Click="Minimize_Click"
                        Style="{StaticResource TitleButtonStyle}">
                    <Path Data="F1 M 20 7.5 L 20 10.498047 L 0 10.498047 L 0 7.5 Z " Fill="#7e7e7e" Stretch="Uniform" 
                          Height="15" Width="15" Margin="0,4,0,0"/>
                </Button>
                <Button Width="40"
                        x:Name="ExitButton"
                        Click="ExitButton_Click"
                        Style="{StaticResource TitleButtonStyle}">
                    <Path Data="F1 M 19.814453 2.314453 L 12.119141 10 L 19.814453 17.685547 L 17.685547 19.814453 L 10 12.119141 L 2.314453 19.814453 L 0.185547 17.685547 L 7.880859 10 L 0.185547 2.314453 L 2.314453 0.185547 L 10 7.880859 L 17.685547 0.185547 Z " 
                          Fill="#7e7e7e" Stretch="Uniform" Height="10" Width="10" Margin="0,2,0,0"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Window Border -->
        <Border BorderThickness="3"
                x:Name="WindowBorder"
                Margin="0,30,0,0"
                Panel.ZIndex="5"
                BorderBrush="#7e7e7e"/>
        
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Audio File: None" 
                       x:Name="AudioFileText"
                       FontSize="14" 
                       HorizontalAlignment="Center" 
                       Margin="10,10,0,10"/>
            <StackPanel Margin="10,0,10,10"
                        HorizontalAlignment="Center">
                <TextBlock Text="FVZ File: None" 
                       x:Name="FVZFileText"
                       FontSize="14" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,0"/>
                <ProgressBar x:Name="FVZProgress" 
                             IsIndeterminate="True"
                             Height="4"
                             Visibility="Hidden"
                             Background="Transparent"
                             BorderThickness="0"/>
            </StackPanel>
            <Slider x:Name="PlaybackSlider"
                    Value="{Binding PlaybackMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Minimum="0" 
                    Maximum="{Binding PlaybackMsMax, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                    SmallChange="0.001"
                    Style="{StaticResource WinUI3SliderStyle}"
                    LargeChange="0.01"
                    ValueChanged="PlaybackSlider_ValueChanged"
                    PreviewMouseDown="PlaybackSlider_PreviewMouseDown"
                    PreviewMouseUp="PlaybackSlider_MouseLeftButtonUp"
                    Margin="50,0,50,0"/>
            <TextBlock Text="{Binding PlaybackTime, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                       x:Name="PlaybackTime"
                       FontSize="24" 
                       HorizontalAlignment="Center" 
                       Margin="0,10,0,10"/>
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="10,0,10,10">
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Grid.Column="0" Grid.Row="0" Margin="0,0,0,0">FPS <Span FontSize="18" ToolTip="Frames Per Second that the FVZ file will pre-generate at">ⓘ</Span></TextBlock>
                    <TextBox x:Name="FPSInput" Width="100" HorizontalAlignment="Left" Text="120" MinHeight="22"
                             Style="{StaticResource WinUI3TextBoxStyle}"
                             TextChanged="FPSInput_TextChanged" Grid.Column="0" Grid.Row="0" Margin="0,0,0,0"/>
                    <TextBlock Grid.Column="0" Grid.Row="0" Margin="0,0,0,0">Audio Delay (ms) <Span FontSize="18" ToolTip="Adds a delay to visuals in case your audio system / speakers has latency">ⓘ</Span></TextBlock>
                    <TextBox x:Name="AudioDelayInput" Width="100" HorizontalAlignment="Left" Text="0" MinHeight="22"
                             Style="{StaticResource WinUI3TextBoxStyle}"
                             TextChanged="AudioDelayInput_TextChanged" Grid.Column="0" Grid.Row="0" Margin="0,0,0,0"/>
                </StackPanel>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Grid.Column="0" Grid.Row="0" Margin="0,0,0,0">Compression <Span FontSize="18" ToolTip="Frames Per Second that the FVZ file will pre-generate at">ⓘ</Span></TextBlock>
                    <StackPanel Margin="0,0,0,0">
                        <CheckBox Content="Enable Delta Encoding"
                                  Style="{StaticResource WinUI3CheckBoxStyle}"
                                  x:Name="DeltaCheck"
                                  Click="Check_Checked"/>
                        <CheckBox Content="Enable Zstd Compression"
                                  x:Name="ZstdCheck"
                                  Style="{StaticResource WinUI3CheckBoxStyle}"
                                  Click="Check_Checked"/> 
                        <StackPanel Margin="0,0,0,0"
                                    Orientation="Horizontal">
                            <RadioButton Content="32 bit" 
                                         Margin="0,0,10,0"
                                         Style="{StaticResource WinUI3RadioButtonStyle}"
                                         Click="Check_Checked"
                                         x:Name="NoQuantCheck"/>
                            <RadioButton Content="Quantized 16 bit" 
                                         Margin="0,0,10,0"
                                         Click="Check_Checked"
                                         Style="{StaticResource WinUI3RadioButtonStyle}"
                                         x:Name="Quant16Check"/>
                            <RadioButton Content="Quantized 8 bit"
                                         x:Name="Quant8Check"
                                         Style="{StaticResource WinUI3RadioButtonStyle}"
                                         Click="Check_Checked"
                                         IsChecked="True"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="10,0,10,10">
                <Button x:Name="PlayButton" 
                        Content="Play" 
                        Width="100" 
                        Style="{StaticResource WinUI3ButtonStyle}"
                        Margin="5"
                        IsEnabled="false"
                        Click="PlayButton_Click"/>
                <Button x:Name="LoadSongButton" 
                        Content="Load Song" 
                        Width="100" 
                        Style="{StaticResource WinUI3ButtonStyle}"
                        Margin="5"
                        Click="LoadSongButton_Click"/>
                <Button x:Name="LoadFVZButton" 
                        Content="Load FVZ" 
                        Width="100" 
                        Style="{StaticResource WinUI3ButtonStyle}"
                        Margin="5"
                        Click="LoadFVZButton_Click"/>
                <Button x:Name="GenerateFVZButton" 
                        Content="Generate FVZ" 
                        Width="100" 
                        Margin="5"
                        Style="{StaticResource WinUI3ButtonStyle}"
                        IsEnabled="false"
                        Click="GenerateFVZButton_Click"/>
                <Button x:Name="ExportFVZButton" 
                        Content="Export FVZ" 
                        Width="100" 
                        Style="{StaticResource WinUI3ButtonStyle}"
                        Margin="5"
                        IsEnabled="false"
                        Click="ExportFVZButton_Click"/>
            </StackPanel>
            <Slider x:Name="VolumeSlider" 
                    Value="{Binding PlayerVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Minimum="0" 
                    Style="{StaticResource WinUI3SliderStyle}"
                    Maximum="1" 
                    SmallChange="0.01"
                    LargeChange="0.1"
                    Margin="150,0,150,10"/>
            <TextBlock Text="🔊" FontSize="24"
                       Margin="115,-36,0,0" HorizontalAlignment="Left"/>
        </StackPanel>
    </Grid>
</Window>
