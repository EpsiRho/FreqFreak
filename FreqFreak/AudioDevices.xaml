<Window x:Class="FreqFreak.AudioDevices"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FreqFreak"
        mc:Ignorable="d"
        Foreground="{DynamicResource MainText}"
        AllowsTransparency="True"
        ResizeMode="NoResize"      
        WindowStyle="None"
        Background="Transparent"
        Title="Audio Device Selector" Height="750" Width="400">
    <Grid Background="{StaticResource MainBg}">
        <!-- Window Title -->
        <Grid Height="30"  
              x:Name="TitleBar"
              Background="#353535"
              VerticalAlignment="Top"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
              MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
            <Image Source="/FreqFreak;component/Images/icon2.png"
                   HorizontalAlignment="Left"
                   Margin="5,1,0,2"/>
            <TextBlock Text="Audio Select"
                       FontSize="16"
                       Margin="35,4,0,0"/>

            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="40" 
                        x:Name="MinimizeButton"
                        Click="Minimize_Click"
                        Style="{StaticResource TitleButtonStyle}">
                    <Path Data="F1 M 20 7.5 L 20 10.498047 L 0 10.498047 L 0 7.5 Z " Fill="#7e7e7e" Stretch="Uniform" 
                          Height="15" Width="15" Margin="0,4,0,0"/>
                </Button>
                <Button Width="40"
                        x:Name="ExitButton"
                        Click="ExitButton_Click"
                        Style="{StaticResource TitleButtonStyle}">
                    <Path Data="F1 M 19.814453 2.314453 L 12.119141 10 L 19.814453 17.685547 L 17.685547 19.814453 L 10 12.119141 L 2.314453 19.814453 L 0.185547 17.685547 L 7.880859 10 L 0.185547 2.314453 L 2.314453 0.185547 L 10 7.880859 L 17.685547 0.185547 Z " 
                          Fill="#7e7e7e" Stretch="Uniform" Height="10" Width="10" Margin="0,2,0,0"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Window Border -->
        <Border BorderThickness="3"
                x:Name="WindowBorder"
                Margin="0,30,0,0"
                Panel.ZIndex="5"
                BorderBrush="#7e7e7e"/>

        <ScrollViewer Margin="0,30,0,0"
                      Padding="15,10,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Width="30" 
                            x:Name="RefreshButton"
                            Margin="0,0,10,0"
                            Click="RefreshButton_Click"
                            Style="{StaticResource WinUI3ButtonStyle}">
                        <Path Data="F1 M 12.666016 0.371094 C 13.746744 0.664062 14.736328 1.12142 15.634766 1.743164 C 16.533203 2.36491 17.306314 3.100586 17.954102 3.950195 C 18.601887 4.799805 19.104816 5.740561 19.462891 6.772461 C 19.820963 7.804362 20 8.880209 20 10 C 20 10.917969 19.881184 11.803386 19.643555 12.65625 C 19.405924 13.509115 19.070637 14.306641 18.637695 15.048828 C 18.204752 15.791016 17.683918 16.466473 17.075195 17.075195 C 16.466471 17.68392 15.791016 18.204752 15.048828 18.637695 C 14.306641 19.070639 13.509114 19.405924 12.65625 19.643555 C 11.803385 19.881186 10.917969 20 10 20 C 9.082031 20 8.196614 19.881186 7.34375 19.643555 C 6.490885 19.405924 5.693359 19.070639 4.951172 18.637695 C 4.208984 18.204752 3.533528 17.68392 2.924805 17.075195 C 2.316081 16.466473 1.795247 15.791016 1.362305 15.048828 C 0.929362 14.306641 0.594076 13.510742 0.356445 12.661133 C 0.118815 11.811523 0 10.924479 0 10 C 0 9.088542 0.120443 8.203125 0.361328 7.34375 C 0.602214 6.484376 0.945638 5.675457 1.391602 4.916992 C 1.837565 4.158529 2.379557 3.468426 3.017578 2.84668 C 3.655599 2.224936 4.375 1.692709 5.175781 1.25 L 2.5 1.25 L 2.5 0 L 7.5 0 L 7.5 5 L 6.25 5 L 6.25 2.099609 C 5.488281 2.464193 4.799805 2.921551 4.18457 3.47168 C 3.569336 4.021811 3.04362 4.640301 2.607422 5.327148 C 2.171224 6.013998 1.835938 6.754558 1.601562 7.548828 C 1.367188 8.3431 1.25 9.160156 1.25 10 C 1.25 10.800781 1.354167 11.573894 1.5625 12.319336 C 1.770833 13.064779 2.06543 13.761394 2.446289 14.40918 C 2.827148 15.056967 3.284505 15.647787 3.818359 16.181641 C 4.352213 16.715496 4.943034 17.172852 5.59082 17.553711 C 6.238606 17.93457 6.933593 18.229166 7.675781 18.4375 C 8.417969 18.645834 9.192708 18.75 10 18.75 C 10.800781 18.75 11.573893 18.645834 12.319336 18.4375 C 13.064778 18.229166 13.761393 17.93457 14.40918 17.553711 C 15.056965 17.172852 15.647785 16.715496 16.181641 16.181641 C 16.715494 15.647787 17.172852 15.056967 17.553711 14.40918 C 17.93457 13.761394 