                                </Span.ToolTip>
                                ⓘ
                            </Span>
                        </TextBlock>
                        <ComboBox x:Name="PosInput" SelectionChanged="SelectionChanged" 
                                  Style="{StaticResource WinUI3ComboBoxStyle}" ItemContainerStyle="{StaticResource WinUI3ComboBoxItemStyle}"
                                  Grid.Column="0" Grid.Row="2" Margin="0,20,0,0" Width="100" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Bottom"/>
                            <ComboBoxItem Content="Center"/>
                            <ComboBoxItem Content="Top"/>
                            <ComboBoxItem Content="OuterCircle"/>
                            <ComboBoxItem Content="InnerCircle"/>
                            <ComboBoxItem Content="Oscilloscope"/>
                        </ComboBox>

                        <TextBlock Grid.Column="1" Grid.Row="2" Margin="0,-5,0,0">Peak Decay 
                            <Span FontSize="18">
                                <Span.ToolTip>
                                    <ToolTip Style="{StaticResource WinUI3ToolTipStyle}" Content="How much a Peak's Height should decay each tick" />
                                </Span.ToolTip>
                                ⓘ
                            </Span>
                        </TextBlock>
                        <TextBox x:Name="PeakDecay" Width="100" HorizontalAlignment="Left"
                                 Style="{StaticResource WinUI3TextBoxStyle}"
                                 TextChanged="Input_TextChanged" Grid.Column="1" Grid.Row="2" Margin="0,20,0,0"/>

                        <TextBlock Grid.Column="2" Grid.Row="2" Margin="0,-5,0,0">Peak Hold 
                            <Span FontSize="18">
                                <Span.ToolTip>
                                    <ToolTip Style="{StaticResource WinUI3ToolTipStyle}" Content="How many frames should a peak stay at it's max" />
                                </Span.ToolTip>
                                ⓘ
                            </Span>
                        </TextBlock>
                        <TextBox x:Name="PeakHold" Width="100" HorizontalAlignment="Left"
                                 Style="{StaticResource WinUI3TextBoxStyle}"
                                 TextChanged="Input_TextChanged" Grid.Column="2" Grid.Row="2" Margin="0,20,0,0"/>

                    </Grid>
                </GroupBox>

                <GroupBox Padding="10,10,10,10" Header="Visualizer Options">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="33*" MinWidth="150"/>
                            <ColumnDefinition Width="33*" MinWidth="150"/>
                            <ColumnDefinition Width="33*" MinWidth="150"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="33*"/>
                            <RowDefinition Height="33*"/>
                            <RowDefinition Height="33*"/>
                            <RowDefinition Height="33*"/>
                            <RowDefinition Height="33*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="0" Grid.Row="0" Margin="0,-5,0,0">DB Floor 
                            <Span FontSize="18">
                                <Span.ToolTip>
                                    <ToolTip Style="{StaticResource WinUI3ToolTipStyle}" Content="Determines how loud a sound must be before it is considered for visualization. Raise this number to let in less noise, lower it to let in more noise" />
                                </Span.ToolTip>
                                ⓘ
                            </Span>
                        </TextBlock>
                        <TextBox x:Name="FloorInput" Width="100" HorizontalAlignment="Left"
                                 Style="{StaticResource WinUI3TextBoxStyle}"
                                 TextChanged="Input_TextChanged" Margin="0,20,0,0"/>

                        <TextBlock Grid.Column="1" Grid.Row="0" Margin="0,-5,0,0">DB Range 
                            <Span FontSize="18">
                                <Span.ToolTip>
                                    <ToolTip Style="{StaticResource WinUI3ToolTipStyle}" Content="Determines the range or variance in loudness, lower values create higher peaks while higher values smooth out peaks" />
                                </Span.ToolTip>
                                ⓘ
                            </Span>
                        </TextBlock>
                        <TextBox x:Name="RangeInput" Width="100" HorizontalAlignment="Left"
                                 Style="{StaticResource WinUI3TextBoxStyle}"
                                 TextChanged="Input_TextChanged" Grid.Column="1" Grid.Row="0" Margin="0,20,0,0"/>

                        <TextBlock Grid.Column="2" Grid.Row="0" Margin="0,-5,0,0">Frequency Min 
                            <Span FontSize="18">
                                <Span.ToolTip>
                                    <ToolTip Style="{StaticResource WinUI3ToolTipStyle}" Content="The lower bound for frequncies to display (Lowest for human hearing is 20)" />
                                </Span.ToolTip>
                                ⓘ
                            </Span>
                        </TextBlock>
                        <TextBox x:Name="FreqMinInput" Width="100" HorizontalAlignment="Left"
                                 Style="{StaticResource WinUI3TextBoxStyle}"
                                 TextChanged="Input_TextChanged" Grid.Column="2" Grid.Row="0" Margin="0,20,0,0"/>

                        <TextBlock Grid.Column="0" Grid.Row="1" Margin="0,-5,0,0">Frequency Max 
                            <Span FontSize="18">
                                <Span.ToolTip>
                                    <ToolTip Style="{StaticResource WinUI3ToolTipStyle}" Content="The upper bound for frequncies to display (Highest for human hearing is 20000)" />
                                </Span.ToolTip>
                                ⓘ
                            </Span>
                        </TextBlock>
                        <TextBox x:Name="FreqMaxInput" Width="100" HorizontalAlignment="Left"
                                 Style="{StaticResource WinUI3TextBoxStyle}"
                                 TextChanged="Input_TextChanged" Grid.Column="0" Grid.Row="1" Margin="0,20,0,0"/>

                        <TextBlock Grid.Column="1" Grid.Row="1" Margin="0,-5,0,0">Binning Smoothness 
                            <Span FontSize="18">
                                <Span.ToolTip>
                                    <ToolTip Style="{StaticResource WinUI3ToolTipStyle}" Content="Determines how much of a bar should &quot;slide&quot; down to nearby lower bars, to smooth out jagged peaks" />
                                </Span.ToolTip>
                                ⓘ
                            </Span>
                        </TextBlock>
                        <TextBox x:Name="BinSmoothInput" Width="100" HorizontalAlignment="Left"
                                 Style="{StaticResource WinUI3TextBoxStyle}"
                                 TextChanged="Input_TextChanged" Grid.Column="1" Grid.Row="1" Margin="0,20,0,0"/>

                        <TextBlock Grid.Column="0" Grid.Row="2" Margin="0,-5,0,0">FFT Resolution 
                            <Span FontSize="18">
                                <Span.ToolTip>
                                    <ToolTip Style="{StaticResource WinUI3ToolTipStyle}" Content="The window size for the FFT function, higher values can take in too much song at once and look incorrect, lower values will give less details in the spectrum" />
                                </Span.ToolTip>
                                ⓘ
                            </Span>
                        </TextBlock>
                        <ComboBox x:Name="FFTResolutionInput" SelectionChanged="SelectionChanged" 
                                  Grid.Column="0" Grid.Row="2" Margin="0,20,0,0"
                                  Style="{StaticResource WinUI3ComboBoxStyle}" ItemContainerStyle="{StaticResource WinUI3ComboBoxItemStyle}"
                                  Width="100" HorizontalAlignment="Left">
                            <ComboBoxItem Content="64"/>
                            <ComboBoxItem Content="128"/>
                            <ComboBoxItem Content="256"/>
                            <ComboBoxItem Content="512"/>
                            <ComboBoxItem Content="1024"/>
                            <ComboBoxItem Content="2048"/>
                            <ComboBoxItem Content="4096"/>
                            <ComboBoxItem Content="8192"/>
                            <ComboBoxItem Content="16384"/>
                            <ComboBoxItem Content="32768"/>
                            <ComboBoxItem Content="65536"/>
                        </ComboBox>

                        <TextBlock Grid.Column="2" Grid.Row="1" Margin="0,-5,0,0">Spectrogram Mapping 
                        <Span FontSize="18">
                                <Span.ToolTip>
                                    <ToolTip Style="{StaticResource WinUI3ToolTipStyle}" Content="The algorithm to use for mapping frequencies to binned bars. Log10 is more raw, Mel is shifted for the human hearing spectrum, and Normalized is Log w/ DB scaling and DB Range normalization" />
                                </Span.ToolTip>
                                ⓘ
                            </Span>
                        </TextBlock>
                        <ComboBox x:Name="SpectrogramInput" Width="100" HorizontalAlignment="Left"
                                  Style="{StaticResource WinUI3ComboBoxStyle}" ItemContainerStyle="{StaticResource WinUI3ComboBoxItemStyle}"
                                  SelectionChanged="SpectrogramInput_SelectionChanged" Grid.Column="2" Grid.Row="1" Margin="0,20,0,0">
                            <ComboBoxItem Content="Normalized"/>
                            <ComboBoxItem Content="Mel"/>
                            <ComboBoxItem Content="Log10"/>
                        </ComboBox>

                        <TextBlock Grid.Column="1" Grid.Row="2" Margin="0,-5,0,0">Attack Speed
                            <Span FontSize="18">
                                <Span.ToolTip>
                                    <ToolTip Style="{StaticResource WinUI3ToolTipStyle}" Content="The % at which bars will rise to meet the current real value. Lower values trade accuracy for smoothness" />
                                </Span.ToolTip>
                                ⓘ
                            </Span>
                        </TextBlock>
                        <TextBox x:Name="AttackSpeedInput" Width="100" HorizontalAlignment="Left"
                                 Style="{StaticResource WinUI3TextBoxStyle}"
                                 TextChanged="Input_TextChanged" Grid.Column="1" Grid.Row="2" Margin="0,20,0,0"/>

                        <TextBlock Grid.Column="2" Grid.Row="2" Margin="0,-5,0,0">Decay Speed 
                            <Span FontSize="18">
                                <Span.ToolTip>
                                    <ToolTip Style="{StaticResource WinUI3ToolTipStyle}" Content="The % at which bars will fall to meet the current real value. Lower values trade accuracy for smoothness" />
                                </Span.ToolTip>
                                ⓘ
                            </Span>
                        </TextBlock>
                        <TextBox x:Name="DecaySpeedInput" Width="100" HorizontalAlignment="Left"
                                 Style="{StaticResource WinUI3TextBoxStyle}"
                                 TextChanged="Input_TextChanged" Grid.Column="2" Grid.Row="2" Margin="0,20,0,0"/>

                        <TextBlock Grid.Column="0" Grid.Row="3" Margin="0,-5,0,0">Invert Spectrum 
                            <Span FontSize="18">
                                <Span.ToolTip>
                                    <ToolTip Style="{StaticResource WinUI3ToolTipStyle}" Content="Determines whether to show from Low End -> High End or from High End -> Low End" />
                                </Span.ToolTip>
                                ⓘ
                            </Span>
                        </TextBlock>
                        <CheckBox x:Name="InvertSpectrum" Width="100" HorizontalAlignment="Left"
                                  Style="{StaticResource WinUI3CheckBoxStyle}"
                                  Click="InvertSpectrum_Click" Grid.Column="0" Grid.Row="3" Margin="0,20,0,0"/>

                        <TextBlock Grid.Column="1" Grid.Row="3" Margin="0,-5,0,0">Rotation 
                            <Span FontSize="18">
                                <Span.ToolTip>
                                    <ToolTip Style="{StaticResource WinUI3ToolTipStyle}" Content="The rotation of the visualizer canvas" />
                                </Span.ToolTip>
                                ⓘ
                            </Span>
                        </TextBlock>
                        <TextBox x:Name="RotationInput" Width="100" HorizontalAlignment="Left"
                                 Style="{StaticResource WinUI3TextBoxStyle}"
                                 TextChanged="Input_TextChanged" Grid.Column="1" Grid.Row="3" Margin="0,20,0,0"/>

                        <TextBlock Grid.Column="2" Grid.Row="3" Margin="0,-5,0,0">Audio Channel 
                            <Span FontSize="18">
                                <Span.ToolTip>
                                    <ToolTip Style="{StaticResource WinUI3ToolTipStyle}" Content="The channel(s) to use for visualization. Some modes my not work with some channel configurations" />
                                </Span.ToolTip>
                                ⓘ
                            </Span>
                        </TextBlock>
                        <ComboBox x:Name="AudioChannelInput" Width="100" HorizontalAlignment="Left"
                                  Style="{StaticResource WinUI3ComboBoxStyle}" ItemContainerStyle="{StaticResource WinUI3ComboBoxItemStyle}"
                                  SelectionChanged="AudioChannelInput_SelectionChanged" Grid.Column="2" Grid.Row="3" Margin="0,20,0,0">
                            <ComboBoxItem Content="Mono"/>
                            <ComboBoxItem Content="Stereo Left"/>
                            <ComboBoxItem Content="Stereo Right"/>
                            <ComboBoxItem Content="Stereo"/>
                        </ComboBox>

                        <TextBlock Grid.Column="0" Grid.Row="4" Margin="0,-5,0,0">Bass Scaling 
                            <Span FontSize="18">
                                <Span.ToolTip>
                                    <ToolTip Style="{StaticResource WinUI3ToolTipStyle}" Content="How much to scale the visualizer when bass is kicking" />
                                </Span.ToolTip>
                                ⓘ
                            </Span>
                        </TextBlock>
                        <TextBox x:Name="ScaleInput" Width="100" HorizontalAlignment="Left"
                                 Style="{StaticResource WinUI3TextBoxStyle}"
                                 TextChanged="Input_TextChanged" Grid.Column="0" Grid.Row="4" Margin="0,20,0,0"/>

                        <TextBlock Grid.Column="1" Grid.Row="4" Margin="0,-5,0,0">Bass Shake 
                            <Span FontSize="18">
                                <Span.ToolTip>
                                    <ToolTip Style="{StaticResource WinUI3ToolTipStyle}" Content="How much to shake the visualizer when bass is kicking" />
                                </Span.ToolTip>
                                ⓘ
                            </Span>
                        </TextBlock>
                        <TextBox x:Name="ShakeInput" Width="100" HorizontalAlignment="Left"
                                 Style="{StaticResource WinUI3TextBoxStyle}"
                                 TextChanged="Input_TextChanged" Grid.Column="1" Grid.Row="4" Margin="0,20,0,0"/>

                        <TextBlock Grid.Column="3" Grid.Row="4" Margin="0,-5,0,0">Show as Lines 
                            <Span FontSize="18">
                                <Span.ToolTip>
                                    <ToolTip Style="{StaticResource WinUI3ToolTipStyle}" Content="Instead of showing bars, a line will draw through the top point of where each bar would be" />
                                </Span.ToolTip>
                                ⓘ
                            </Span>
                        </TextBlock>
                        <CheckBox x:Name="LinesInput" Width="100" HorizontalAlignment="Left"
                                  Style="{StaticResource WinUI3CheckBoxStyle}"
                                  Click="LinesInput_Click" Grid.Column="3" Grid.Row="4" Margin="0,20,0,0"/>
                    </Grid>
                </GroupBox>

                <GroupBox Padding="10,10,10,10" Header="Styling Options">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="33*" MinWidth="150"/>
                            <ColumnDefinition Width="33*" MinWidth="150"/>
                            <ColumnDefinition Width="33*" MinWidth="150"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="33*" MinHeight="40"/>
                            <RowDefinition Height="33*" MinHeight="40"/>
                            <RowDefinition Height="33*" MinHeight="40"/>
                            <RowDefinition Height="33*" MinHeight="40"/>
                            <RowDefinition Height="33*" MinHeight="40"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="0" Grid.Row="0" Margin="0,0,0,0">Bar Color Type</TextBlock>
                        <ComboBox x:Name="BarColorTypeInput" SelectionChanged="BarColorTypeInput_SelectionChanged"
                                  Style="{StaticResource WinUI3ComboBoxStyle}" ItemContainerStyle="{StaticResource WinUI3ComboBoxItemStyle}"
                                  Grid.Column="0" Grid.Row="0" Width="140" HorizontalAlignment="Left" Margin="0,20,0,0">
                            <ComboBoxItem Content="Solid Color"/>
                            <ComboBoxItem Content="Dual Color Vertical"/>
                            <ComboBoxItem Content="Dual Color Horizontal"/>
                            <ComboBoxItem Content="Dual Color Height"/>
                            <ComboBoxItem Content="Dual Color Pitch"/>
                            <ComboBoxItem Content="Dual Color Frequency"/>
                            <ComboBoxItem Content="Gradient Vertical"/>
                            <ComboBoxItem Content="Gradient Horizontal"/>
                            <ComboBoxItem Content="Gradient Height"/>
                            <ComboBoxItem Content="Gradient Pitch"/>
                            <ComboBoxItem Content="Gradient Frequency"/>
                        </ComboBox>

                        <TextBlock Text="Color 1" Margin="2,0,0,0" x:Name="ColorOneLabel"
                                   Grid.Column="1" Grid.Row="0"/>
                        <colorpicker:PortableColorPicker x:Name="BarColorOne" 
                                                         Style="{StaticResource DefaultColorPickerStyle}"
                                                         Width="50" 
                                                         Height="30"
                                                         Grid.Column="1" Grid.Row="0"
                                                         Margin="0,20,0,0"
                                                         HorizontalAlignment="Left"
                                                         ColorChanged="BarColor_ColorChanged"/>

                        <Button Grid.Column="1" 
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Left"
                                x:Name="GradientEditButton"
                                Height="30"
                                Click="GradientEditButton_Click"
                                Style="{StaticResource WinUI3ButtonStyle}"
                                Margin="0,20,-10,0"
                                Content="Edit Gradient"
                                Visibility="Collapsed"
                                Grid.Row="0"/>

                        <Button Width="60" 
                                Grid.Column="1" 
                                Style="{StaticResource WinUI3ButtonStyle}"
                                x:Name="SwapButton"
                                Click="SwapButton_Click"
                                Height="30"
                                Margin="50,20,0,0"
                                Content="Swap"
                                Grid.Row="0"/>

                        <TextBlock Text="Color 2" Margin="2,0,0,0" x:Name="ColorTwoLabel"
                                   Grid.Column="2" Grid.Row="0"/>
                        <colorpicker:PortableColorPicker x:Name="BarColorTwo" 
                                                         Style="{StaticResource DefaultColorPickerStyle}"
                                                         Width="50" 
                                                         Height="30"
                                                         Grid.Column="2" Grid.Row="0"
                                                         Margin="0,20,0,0"
                                                         HorizontalAlignment="Left"
                                                         ColorChanged="BarColor_ColorChanged"/>

                        <TextBlock Text="Color Change Amount" Margin="0,0,0,0" Grid.Column="0" Grid.Row="2" x:Name="ColorChangeLabel1"/>
                        <TextBox x:Name="ColorMoveSpeedInput" Width="100" HorizontalAlignment="Left"
                                 Style="{StaticResource WinUI3TextBoxStyle}"
                                 TextChanged="Input_TextChanged" Grid.Column="0" Grid.Row="2" Margin="0,20,0,0"/>
                        <TextBlock Text="Color Change Frequency" Margin="0,0,0,0" x:Name="ColorChangeLabel2"
                                   Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2"/>
                        <TextBox x:Name="ColorChangeFreqInput" Width="100" HorizontalAlignment="Left"
                                 Style="{StaticResource WinUI3TextBoxStyle}"
                                 TextChanged="Input_TextChanged" Grid.Column="1" Grid.Row="2" Margin="0,20,0,0"/>

                        <TextBlock Text="Show Centerline" Margin="0,0,0,0"
                                   Grid.Column="2" Grid.Row="2" Grid.ColumnSpan="1"/>
                        <CheckBox x:Name="CenterlineInput" Width="100" HorizontalAlignment="Left" IsChecked="False"
                                  Style="{StaticResource WinUI3CheckBoxStyle}"
                                  Click="CenterlineInput_Click" Grid.Column="2" Grid.Row="2" Margin="0,22,0,0"/>

                        <TextBlock Text="Peak Color:" Margin="0,0,0,0" Grid.Column="1" Grid.Row="1" x:Name="ColorThreeLabel"/>
                        <colorpicker:PortableColorPicker x:Name="PeakColor" 
                                                         Style="{StaticResource DefaultColorPickerStyle}"
                                                         Width="50" 
                                                         Height="30"
                                                         Grid.Column="1" Grid.Row="1"
                                                         Margin="0,20,0,0"
                                                         HorizontalAlignment="Left"
                                                         ColorChanged="BarColor_ColorChanged"/>

                        <Button Grid.Column="1" 
                                HorizontalAlignment="Left"
                                Style="{StaticResource WinUI3ButtonStyle}"
                                x:Name="PeakGradientEditButton"
                                Click="PeakGradientEditButton_Click"
                                Margin="0,20,0,0"
                                Height="30"
                                Content="Edit Gradient"
                                Visibility="Collapsed"
                                Grid.Row="1"/>

                        <Button Width="60" 
                                Grid.Column="1" 
                                Style="{StaticResource WinUI3ButtonStyle}"
                                x:Name="PeakSwapButton"
                                Click="PeakSwapButton_Click"
                                Height="30"
                                Margin="50,20,0,0"
                                Content="Swap"
                                Grid.Row="1"/>

                        <TextBlock Text="Peak Color 2" Margin="2,1,0,0" x:Name="ColorFourLabel"
                                   Grid.Column="2" Grid.Row="1"/>
                        <colorpicker:PortableColorPicker x:Name="PeakColorTwo" 
                                                         Style="{StaticResource DefaultColorPickerStyle}"
                                                         Width="50" 
                                                         Height="30"
                                                         Grid.Column="2" Grid.Row="1"
                                                         Margin="0,20,0,0"
                                                         HorizontalAlignment="Left"
                                                         ColorChanged="BarColor_ColorChanged"/>

                        <TextBlock Grid.Column="0" Grid.Row="1" Margin="0,0,0,0">Peak Color Type</TextBlock>
                        <ComboBox x:Name="PeakColorTypeInput" SelectionChanged="BarColorTypeInput_SelectionChanged"
                                  Style="{StaticResource WinUI3ComboBoxStyle}" ItemContainerStyle="{StaticResource WinUI3ComboBoxItemStyle}"
                                  Height="30"
                                  Grid.Column="0" Grid.Row="1" Width="140" HorizontalAlignment="Left" Margin="0,20,0,0">
                            <ComboBoxItem Content="Match Bars"/>
                            <ComboBoxItem Content="Solid Color"/>
                            <ComboBoxItem Content="Dual Color Vertical"/>
                            <ComboBoxItem Content="Dual Color Horizontal"/>
                            <ComboBoxItem Content="Dual Color Height"/>
                            <ComboBoxItem Content="Dual Color Pitch"/>
                            <ComboBoxItem Content="Dual Color Frequency"/>
                            <ComboBoxItem Content="Gradient Vertical"/>
                            <ComboBoxItem Content="Gradient Horizontal"/>
                            <ComboBoxItem Content="Gradient Height"/>
                            <ComboBoxItem Content="Gradient Pitch"/>
                            <ComboBoxItem Content="Gradient Frequency"/>
                        </ComboBox>

                        <TextBlock Text="Color Movement Direction" Margin="0,2,0,0" Grid.Column="0" Grid.Row="3" />
                        <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="3">
                            <RadioButton x:Name="NoMovement" Width="100" HorizontalAlignment="Left" Content="None"
                                         Style="{StaticResource WinUI3RadioButtonStyle}"
                                         Click="NoMovement_Click" Grid.Column="2" Grid.Row="1" Margin="0,20,0,0"/>
                            <RadioButton x:Name="LeftMovement" Width="100" HorizontalAlignment="Left" Content="Left"
                                         Style="{StaticResource WinUI3RadioButtonStyle}"
                                         Click="NoMovement_Click" Grid.Column="2" Grid.Row="1" Margin="0,20,0,0"/>
                            <RadioButton x:Name="RightMovement" Width="100" HorizontalAlignment="Left" Content="Right"
                                         Style="{StaticResource WinUI3RadioButtonStyle}"
                                         Click="NoMovement_Click" Grid.Column="2" Grid.Row="1" Margin="0,20,0,0"/>

                        </StackPanel>

                        <TextBlock Text="Tray Icon Color" Margin="0,0,0,0" Grid.Column="0" Grid.Row="4"/>
                        <colorpicker:PortableColorPicker x:Name="TrayIconColor" 
                                                         Style="{StaticResource DefaultColorPickerStyle}"
                                                         Width="50" 
                                                         Height="25"
                                                         Grid.Column="0" Grid.Row="4"
                                                         Margin="0,20,0,0"
                                                         HorizontalAlignment="Left"
                                                         ColorChanged="TrayIconColor_ColorChanged"/>

                        <TextBlock Text="Always On Top" Margin="0,1,0,0" Grid.Column="1" Grid.Row="4" />
                        <CheckBox x:Name="OnTopInput" Width="100" HorizontalAlignment="Left" IsChecked="True"
                                  Style="{StaticResource WinUI3CheckBoxStyle}"
                                  Click="OnTopInput_Click" Grid.Column="1" Grid.Row="4" Margin="0,22,0,0"/>

                        <TextBlock Text="Preview" Margin="0,2,0,0" Grid.Column="2" Grid.Row="4" />
                        <CheckBox x:Name="PreviewInput" Width="100" HorizontalAlignment="Left" IsChecked="False"
                                  Style="{StaticResource WinUI3CheckBoxStyle}"
                                  Click="PreviewInput_Click" Grid.Column="2" Grid.Row="4" Margin="0,22,0,0"/>
                    </Grid>
                </GroupBox>
                <TextBlock Text="Version 2.0.0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Resize hitboxes -->
        <Rectangle x:Name="LeftBorder"    
                   Width="5"
                   Panel.ZIndex="10"
                   Fill="Transparent"
                   HorizontalAlignment="Left"
                   Cursor="SizeWE"
                   MouseLeftButtonDown="Resize_MouseLeftButtonDown"/>
        <Rectangle x:Name="RightBorder"
                   Width="5"
                   Fill="Transparent"
                   HorizontalAlignment="Right"
                   Panel.ZIndex="10"
                   Cursor="SizeWE"
                   MouseLeftButtonDown="Resize_MouseLeftButtonDown"/>
        <Rectangle x:Name="TopBorder"
                   Height="5"
                   VerticalAlignment="Top"
                   Fill="Transparent"
                   Panel.ZIndex="10"
                   Cursor="SizeNS"
                   MouseLeftButtonDown="Resize_MouseLeftButtonDown"/>
        <Rectangle x:Name="BottomBorder"
                   Height="5"
                   VerticalAlignment="Bottom"
                   Panel.ZIndex="10"
                   Fill="Transparent"
                   Cursor="SizeNS"
                   MouseLeftButtonDown="Resize_MouseLeftButtonDown"/>

        <!-- corners -->
        <Rectangle x:Name="TopLeft"
                   Width="10"
                   Height="10"
                   HorizontalAlignment="Left"  
                   Panel.ZIndex="10"
                   Fill="Transparent"
                   VerticalAlignment="Top"
                   Cursor="SizeNWSE"
                   MouseLeftButtonDown="Resize_MouseLeftButtonDown"/>
        <Rectangle x:Name="TopRight" 
                   Width="10" 
                   Height="10"
                   HorizontalAlignment="Right" 
                   VerticalAlignment="Top"
                   Fill="Transparent"
                   Panel.ZIndex="10"
                   Cursor="SizeNESW"
                   MouseLeftButtonDown="Resize_MouseLeftButtonDown"/>
        <Rectangle x:Name="BottomLeft"
                   Width="10"
                   Height="10"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Fill="Transparent"
                   Panel.ZIndex="10"
                   Cursor="SizeNESW"
                   MouseLeftButtonDown="Resize_MouseLeftButtonDown"/>
        <Rectangle x:Name="BottomRight"
                   Width="10"  
                   Panel.ZIndex="10"
                   Height="10"
                   HorizontalAlignment="Right" 
                   VerticalAlignment="Bottom"
                   Fill="Transparent"
                   Cursor="SizeNWSE"
                   MouseLeftButtonDown="Resize_MouseLeftButtonDown"/>
        
    </Grid>
</Window>
