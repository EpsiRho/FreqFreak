<Window x:Class="FreqFreak.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FreqFreak"
        xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
        mc:Ignorable="d"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="CanResize"      
        WindowStyle="None"
        IsHitTestVisible="True"
        Foreground="{DynamicResource ResourceKey=MainText}"
        Title="FreqFreak Options" Height="890" Width="490" MinWidth="490">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ColorPicker;component/Styles/DefaultColorPickerStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Window.Resources>

    <Grid SizeChanged="Grid_SizeChanged" x:Name="MainGrid">

        <!-- Window Title -->
        <Grid Height="30"  
              x:Name="TitleBar"
              Background="{DynamicResource ResourceKey=TitleBg}"
              VerticalAlignment="Top"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
              MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
            <Image Source="/FreqFreak;component/Images/icon2.png"
                   HorizontalAlignment="Left"
                   Margin="5,1,0,2"/>
            <TextBlock Text="FreqFreak Options"
                       FontSize="16"
                       Margin="35,4,0,0"/>

            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="40" 
                        x:Name="MinimizeButton"
                        Click="Minimize_Click"
                        Style="{StaticResource TitleButtonStyle}">
                    <Path Data="F1 M 20 7.5 L 20 10.498047 L 0 10.498047 L 0 7.5 Z " Fill="#7e7e7e" Stretch="Uniform" 
                          Height="15" Width="15" Margin="0,4,0,0"/>
                </Button>
                <Button Width="40"
                        x:Name="ExitButton"
                        Click="ExitButton_Click"
                        Style="{StaticResource TitleButtonStyle}">
                    <Path Data="F1 M 19.814453 2.314453 L 12.119141 10 L 19.814453 17.685547 L 17.685547 19.814453 L 10 12.119141 L 2.314453 19.814453 L 0.185547 17.685547 L 7.880859 10 L 0.185547 2.314453 L 2.314453 0.185547 L 10 7.880859 L 17.685547 0.185547 Z " 
                          Fill="#7e7e7e" Stretch="Uniform" Height="10" Width="10" Margin="0,2,0,0"/>
                </Button>
            </StackPanel>
        </Grid>
        
        <!-- Window Border -->
        <Border BorderThickness="3"
                x:Name="WindowBorder"
                Margin="0,30,0,0"
                Panel.ZIndex="5"
                BorderBrush="#7e7e7e"/>

        <Border BorderThickness="3"
                Margin="0,30,0,0"
                IsHitTestVisible="True"
                Panel.ZIndex="0"
                Background="{StaticResource HitRegBg}"/>


        <!-- Header -->
        <Grid VerticalAlignment="Top" Height="40" Margin="15,42,15,0"
              IsHitTestVisible="True">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Height="35" VerticalAlignment="Top" Margin="-5,0,-5,0" x:Name="FPSStatus" 
                        IsHitTestVisible="True"
                        Grid.Column="0" Grid.ColumnSpan="3" />
            </Grid>


            <Grid Margin="0,6,0,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="FPSMeter" Text="N/A" Foreground="White" Grid.Column="0"
                           IsHitTestVisible="True"
                           FontSize="16" HorizontalAlignment="Left"/>
                <TextBlock x:Name="FFTPSMeter" Text="N/A" Foreground="White" Grid.Column="1"
                           IsHitTestVisible="True"
                           FontSize="16" HorizontalAlignment="Left"/>
                <TextBlock x:Name="PitchDisplay" Text="N/A" Foreground="White" Grid.Column="2"
                           IsHitTestVisible="True"
                           FontSize="16" HorizontalAlignment="Left"/>
            </Grid>
        </Grid>

        <Grid Background="{DynamicResource ResourceKey=MainBg}"
              VerticalAlignment="Top"
              Margin="0,30,0,0"
              Height="10"/>


        <Grid Background="{DynamicResource ResourceKey=MainBg}"
              VerticalAlignment="Top"
              Margin="0,40,0,0"
              x:Name="HeaderCutoutGrid"
              Height="40">
            <Grid.Clip>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <!-- Full Rectangle -->
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry Rect="0,0,400,200"/>
                    </CombinedGeometry.Geometry1>

                    <!-- Inner rounded rectangle to exclude -->
                    <CombinedGeometry.Geometry2>
                        <RectangleGeometry Rect="10,2,100,35" RadiusX="10" RadiusY="10"/>
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Grid.Clip>
            
        </Grid>


        <ScrollViewer Background="{DynamicResource ResourceKey=MainBg}" 
                      Margin="0,80,0,0" 
                      x:Name="SettingsContent"> <!-- Settings Controls -->
            <StackPanel Orientation="Vertical" Margin="10,0,5,10">
                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20*"/>
                        <ColumnDefinition Width="20*"/>
                        <ColumnDefinition Width="25*"/>
                        <ColumnDefinition Width="15*"/>
                        <ColumnDefinition Width="15*"/>
                        <ColumnDefinition Width="15*"/>
                        <ColumnDefinition Width="15*"/>
                        <ColumnDefinition Width="15*"/>
