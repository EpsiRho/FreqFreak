                            <Span FontSize="18">
                                <Span.ToolTip>
                                    <ToolTip Style="{StaticResource WinUI3ToolTipStyle}" Content="How wide the gap between bars should be" />
                                </Span.ToolTip>
                                ⓘ
                            </Span>
                        </TextBlock>
                        <TextBox x:Name="BarGapInput" Width="100" HorizontalAlignment="Left"
                                 Style="{StaticResource WinUI3TextBoxStyle}"
                                 TextChanged="Input_TextChanged" Grid.Column="1" Grid.Row="1" Margin="0,20,0,0"/>

                        <TextBlock Grid.Column="2" Grid.Row="1" Margin="0,-5,0,0">Show Peak Lines 
                            <Span FontSize="18">
                                <Span.ToolTip>
                                    <ToolTip Style="{StaticResource WinUI3ToolTipStyle}" Content="Show lines at the peak of each bar that decay at a slower, steady pace" />
                                </Span.ToolTip>
                                ⓘ
                            </Span>
